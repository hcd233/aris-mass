  "cards": [
    { "dot": "cyan", "title": "Routing & Stable Identity", "items": ["Aliases resolve from owned tenant to public pool, then optional user_id=0 shared pool", "Ascending priority tiers use A-Res weighted shuffle; session or first-prompt affinity lasts 5 minutes", "Guard key is BaseURL|sha256(APIKey)[:8]; OAuth uses BaseURL|oauth:{endpointID}, never the token"] },
    { "dot": "emerald", "title": "Retry, Fallback & Defenses", "items": ["Up to 6 attempts per endpoint with exponential backoff + jitter; connection errors / 5xx / 429 retry", "Switchable pre-stream errors try the next candidate; exhaustion returns the last error", "Default breaker: 60s window, ≥10 requests and ≥50% failures, one probe after 30s; semaphore ≤32 / 1s"] },
    { "dot": "rose", "title": "SSE & Observability Boundaries", "items": ["Guard Lease covers the response body; slow streams hold slots and non-EOF errors count on Close", "429 can retry and fall back without tripping the breaker; delivered SSE never switches endpoints", "upstream_circuit_state / open_total / rejected_total / bulkhead_rejected_total use redacted keys"] }
