    { "dot": "cyan", "title": "Change Broadcast", "items": ["Admin writes trigger_words (word · deny/omit/capture), then calls NotifyChanged", "Redis Publish(trigger:changed) gives an immediate signal; INCR(trigger:version) broadcasts the version", "Every Pod uses triple sync: pub/sub immediately · version polling every 2s · five-minute fallback scan"] },
    { "dot": "emerald", "title": "Matching & Actions", "items": ["ListAll rebuilds the full Aho-Corasick matcher; an RWMutex protects the in-memory index", "deny returns the protocol-native content_filter / refusal; omit forwards but skips session storage", "capture applies only to the last user prompt, saves prior context and avoids upstream; priority deny > capture > omit"] },
